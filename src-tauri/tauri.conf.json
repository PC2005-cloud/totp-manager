{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "totp-manager",
  "version": "0.1.0",
  "identifier": "com.totpmanager.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "TOTP Manager",
        "width": 480,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
